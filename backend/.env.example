# ============================================================
# All In One (Abc Authentic) - Backend Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# Database (PostgreSQL - abc_authentic_new on v2 VM)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/abc_authentic_new

# Auth - short-lived access tokens + rotating refresh tokens
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Email (Gmail SMTP - free, 500/day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=All In One (Abc Authentic)

# Public base URL used in verification / password-reset email links
APP_URL=https://abc-authentic.store

# Admin seed (used only by seed script, optional)
ADMIN_PHONE=
ADMIN_PASSWORD=

# SMS auto-match webhook (bKash/Nagad/Rocket SMS forwarding)
# Generate: openssl rand -hex 24
# The forwarding app must send this as ?secret=, x-sms-secret header, or body.secret
SMS_WEBHOOK_SECRET=

# BDRIS engine — optional Gemini key for captcha "auto calculate" fallback
# (local offline solver is tried first; without a key, user types captcha manually)
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
