# ============================================================
# All In One (Abc Authentic) - Backend Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# Database (PostgreSQL - abc_authentic_new on v2 VM)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/abc_authentic_new

# Auth - short-lived access tokens + rotating refresh tokens
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Email (Gmail SMTP - free, 500/day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=All In One (Abc Authentic)

# Public base URL used in verification / password-reset email links
APP_URL=https://abc-authentic.store

# Admin seed (used only by seed script, optional)
ADMIN_PHONE=
ADMIN_PASSWORD=

# SMS auto-match webhook (bKash/Nagad/Rocket SMS forwarding)
# Generate: openssl rand -hex 24
# The forwarding app must send this as ?secret=, x-sms-secret header, or body.secret
SMS_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) - order/recharge auto notifications
# Free tier: 1000 messages/month. Get credentials from:
# developers.facebook.com -> My Apps -> WhatsApp -> API Setup
# Master switch: must be 'true' AND token + phone number ID must be set,
# otherwise the module logs and skips (never crashes).
# The admin can additionally toggle it in Settings (settings.whatsapp.enabled).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional: your WhatsApp Business display number (shown in admin settings)
WHATSAPP_BUSINESS_NUMBER=

# BDRIS engine — optional Gemini key for captcha "auto calculate" fallback
# (local offline solver is tried first; without a key, user types captcha manually)
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Web Push (VAPID) - admin sound notifications even with screen off
# Generate once: cd backend && npx web-push generate-vapid-keys
# Public key is served by the API (/api/push/vapid-public-key); the
# PRIVATE key must stay secret (VM .env only, never committed).
# If empty, push is disabled gracefully (admin toggle will fail silently).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abc-authentic.store
