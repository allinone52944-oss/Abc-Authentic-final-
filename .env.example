# All In One (Abc Authentic) — environment template (L-9, 2026-10-15)
# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/abc_authentic_new
JWT_SECRET=change-me-to-a-long-random-string

# --- App ---
PORT=3001
APP_URL=https://abc-authentic.store
CORS_ORIGINS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# --- Backups (H-7) ---
BACKUP_DIR=/opt/all-in-one-abc-authentic/backups
BACKUP_RETENTION=7

# --- SMS webhook auto-approve (L-9: was missing) ---
SMS_WEBHOOK_SECRET=change-me
SMS_MAX_AUTO_APPROVE=50000

# --- WhatsApp (L-9: WHATSAPP_TEST_TO was missing) ---
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_TO=

# --- Email (verification / reset links) ---
SMTP_USER=
SMTP_FROM=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abc-authentic.store
